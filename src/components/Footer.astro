---
import { siteConfig, getWhatsAppUrl } from '../config/site';
import Icon from './Icon.astro';

const whatsappUrl = getWhatsAppUrl();

const productLinks = [
  { label: 'Mobility Readiness Assessment®', href: '/metodologia#diagnostico' },
  { label: 'Mobility Business Case®', href: '/metodologia#decisao' },
  { label: 'Procurement Advisory®', href: '/metodologia#contratacao' },
  { label: 'Mobility Transformation®', href: '/metodologia#transformacao' },
  { label: 'Mobility Office®', href: '/metodologia#governanca' },
];

const institutionalLinks = [
  { label: 'Metodologia MOVE®', href: '/metodologia' },
  { label: 'Sobre a LuHao Mobiliza', href: '/sobre' },
  { label: 'Case ilustrativo', href: '/cases' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contato', href: '/contato' },
];
---

<footer class="lm-footer">
  <div class="lm-footer__main">
    <div class="lm-footer__container">
      <div class="lm-footer__brand">
        <a href="/" class="lm-footer__logo" aria-label="Ir para a página inicial da LuHao Mobiliza">
          <img src={siteConfig.logo} alt={siteConfig.logoAlt} />
        </a>

        <p>
          Consultoria independente de mobilidade corporativa e gestão de frotas. Diagnóstico, decisão, contratação, transformação e governança — com a metodologia MOVE®.
        </p>

        <div class="lm-footer__social" aria-label="Redes sociais da LuHao Mobiliza">
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <Icon name="linkedin-in" />
          </a>
          <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <Icon name="instagram" />
          </a>
        </div>
      </div>

      <nav class="lm-footer__column" aria-label="Produtos">
        <h3>Produtos</h3>
        <ul>
          {productLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="lm-footer__column" aria-label="Institucional">
        <h3>Institucional</h3>
        <ul>
          {institutionalLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="lm-footer__contact">
        <h3>Fale com a Mobiliza</h3>
        <ul>
          <li>
            <Icon name="whatsapp" />
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{siteConfig.phoneLabel}</a>
          </li>
          <li>
            <Icon name="envelope" />
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </li>
          <li>
            <Icon name="map-marker-alt" />
            <span>{siteConfig.address}</span>
          </li>
        </ul>

        <a href={whatsappUrl} class="lm-footer__cta" target="_blank" rel="noopener noreferrer">
          Solicitar diagnóstico
        </a>
      </div>
    </div>
  </div>

  <div class="lm-footer__bottom">
    <div class="lm-footer__bottom-container">
      <p>Copyright © {new Date().getFullYear()} LuHao Mobiliza. Todos os direitos reservados.</p>
      <div>
        <a href="/contato">Contato</a>
        <a href="/sobre">Sobre</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .lm-footer {
    background: #071a3a;
    color: #ffffff;
  }

  .lm-footer__main {
    padding: 64px 0 48px;
    background: linear-gradient(160deg, #0b2a5a, #071a3a 70%);
  }

  .lm-footer__container,
  .lm-footer__bottom-container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .lm-footer__container {
    display: grid;
    grid-template-columns: 1.5fr 1.1fr 1.1fr 1.1fr;
    gap: 36px;
    align-items: start;
  }

  .lm-footer__logo {
    display: inline-flex;
    margin-bottom: 18px;
  }

  .lm-footer__logo img {
    width: 160px;
    max-height: 52px;
    object-fit: contain;
    display: block;
  }

  .lm-footer__brand p {
    max-width: 320px;
    margin: 0 0 22px;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .lm-footer h3 {
    margin: 0 0 18px;
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lm-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lm-footer li + li {
    margin-top: 10px;
  }

  .lm-footer a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lm-footer a:hover {
    color: var(--lm-pink);
  }

  .lm-footer__column a {
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .lm-footer__contact li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.92rem;
  }

  .lm-footer__contact :global(svg) {
    width: 15px;
    height: 15px;
    margin-top: 3px;
    color: var(--lm-cyan);
  }

  .lm-footer__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 22px;
    min-height: 46px;
    padding: 12px 20px;
    border-radius: 6px;
    background: var(--lm-pink);
    color: #ffffff !important;
    font-weight: 800;
    font-size: 0.9rem;
    box-shadow: 0 16px 32px rgba(255, 47, 168, 0.24);
  }

  .lm-footer__cta:hover {
    background: #ffffff;
    color: var(--lm-navy) !important;
  }

  .lm-footer__social {
    display: flex;
    gap: 10px;
  }

  .lm-footer__social a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .lm-footer__social a:hover {
    background: var(--lm-pink);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .lm-footer__bottom {
    padding: 18px 0;
    background: #05122a;
  }

  .lm-footer__bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .lm-footer__bottom p {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
  }

  .lm-footer__bottom div {
    display: flex;
    gap: 18px;
  }

  .lm-footer__bottom a {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 1100px) {
    .lm-footer__container {
      grid-template-columns: 1.4fr 1fr 1fr;
    }

    .lm-footer__brand {
      grid-column: span 3;
    }
  }

  @media (max-width: 760px) {
    .lm-footer__container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .lm-footer__brand {
      grid-column: auto;
    }

    .lm-footer__brand p {
      max-width: none;
    }

    .lm-footer__bottom-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
