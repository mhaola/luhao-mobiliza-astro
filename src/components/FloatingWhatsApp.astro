---
import { getWhatsAppUrl } from '../config/site';

interface Props {
  message?: string;
  label?: string;
}

const {
  message = 'Olá, quero falar com a LuHao Mobiliza sobre consultoria de mobilidade corporativa.',
  label = 'Falar no WhatsApp',
} = Astro.props;
const whatsappUrl = getWhatsAppUrl(message);
---

<a class="lm-floating-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={label}>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M16.04 3C8.86 3 3.02 8.78 3.02 15.9c0 2.28.6 4.5 1.75 6.46L3 29l6.82-1.78a13.1 13.1 0 0 0 6.22 1.57C23.22 28.8 29.06 23 29.06 15.9S23.22 3 16.04 3Zm0 23.6c-1.9 0-3.76-.5-5.38-1.47l-.39-.23-4.05 1.06 1.08-3.92-.26-.4a10.58 10.58 0 0 1-1.63-5.74c0-5.9 4.77-10.7 10.63-10.7 5.87 0 10.64 4.8 10.64 10.7 0 5.9-4.77 10.7-10.64 10.7Zm5.84-8.02c-.32-.16-1.9-.93-2.2-1.04-.3-.1-.51-.16-.73.16-.21.32-.84 1.04-1.03 1.25-.19.21-.38.24-.7.08-.32-.16-1.36-.5-2.58-1.6-.95-.85-1.6-1.9-1.78-2.22-.19-.32-.02-.5.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.54.11-.21.05-.4-.03-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.21 0-.56.08-.86.4-.3.32-1.13 1.1-1.13 2.68s1.16 3.12 1.32 3.33c.16.21 2.28 3.47 5.52 4.86.77.33 1.37.53 1.84.68.77.25 1.48.21 2.03.13.62-.09 1.9-.77 2.17-1.52.27-.75.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37Z"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .lm-floating-whatsapp {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 9999;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 18px;
    border-radius: 999px;
    background: #1c2b4a;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 13.5px;
    line-height: 1;
    box-shadow: 0 18px 36px rgba(6, 26, 61, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .lm-floating-whatsapp:hover {
    color: #ffffff;
    background: #25d366;
    transform: translateY(-2px);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.28);
  }

  .lm-floating-whatsapp svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .lm-floating-whatsapp {
      right: 16px;
      bottom: 16px;
      padding: 13px;
    }

    .lm-floating-whatsapp span {
      display: none;
    }
  }
</style>
