---
const gtmId = import.meta.env.PUBLIC_GTM_ID;

/**
 * Tracking otimizado para PageSpeed mobile.
 *
 * Objetivo:
 * - Não carregar o Google Tag Manager durante a renderização inicial.
 * - Carregar após primeira interação real do usuário OU alguns segundos após o load.
 * - Evitar múltiplos carregamentos.
 *
 * Todas as tags (GA4, Meta Pixel, etc.) são configuradas dentro do próprio
 * container do GTM, não no código do site.
 */
---

{gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    (() => {
      let loaded = false;
      let idleTimer = null;
      const w = window;
      const d = document;

      const loadGTM = () => {
        if (loaded) return;
        loaded = true;

        if (idleTimer) {
          window.clearTimeout(idleTimer);
          idleTimer = null;
        }

        (function (win, doc, script, layer, id) {
          win[layer] = win[layer] || [];
          win[layer].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          const first = doc.getElementsByTagName(script)[0];
          const tag = doc.createElement(script);
          const dl = layer !== 'dataLayer' ? '&l=' + layer : '';
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtm.js?id=' + id + dl;
          first.parentNode.insertBefore(tag, first);
        })(w, d, 'script', 'dataLayer', gtmId);
      };

      const scheduleAfterLoad = () => {
        // Mantém o GTM fora do caminho crítico do FCP/LCP.
        const delay = 4500;

        if ('requestIdleCallback' in w) {
          w.requestIdleCallback(loadGTM, { timeout: delay });
        } else {
          idleTimer = w.setTimeout(loadGTM, delay);
        }
      };

      const interactionEvents = ['pointerdown', 'keydown', 'touchstart'];

      interactionEvents.forEach((eventName) => {
        w.addEventListener(eventName, loadGTM, {
          once: true,
          passive: true,
          capture: true,
        });
      });

      if (d.readyState === 'complete') {
        scheduleAfterLoad();
      } else {
        w.addEventListener('load', scheduleAfterLoad, { once: true });
      }
    })();
  </script>
)}
