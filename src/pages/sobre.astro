---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';

const pageTitle = 'Sobre a LuHao Mobiliza | Fleet & Mobility';
const pageDescription = 'A LuHao Mobiliza é a consultoria de mobilidade corporativa do grupo LuHao. Diagnóstico, decisão, contratação, transformação e governança de frotas, com independência e evidência.';

const audiences = [
  'Empresas com frota própria, alugada ou terceirizada de porte médio a grande',
  'Empresas industriais, distribuidoras e prestadoras de serviço com operação dependente de veículos',
  'CFOs, COOs e gestores de frota que precisam decidir entre propriedade, leasing, terceirização, assinatura ou modelos híbridos',
  'Organizações que já têm uma frota, mas não têm clareza sobre custo total, risco e maturidade de gestão',
];

const notFor = [
  'Auditoria contábil ou parecer jurídico',
  'Due diligence técnica de veículos',
  'Elaboração integral de RFP sem diagnóstico prévio',
  'Implementação sem uma decisão formalizada',
];

const values = [
  { title: 'Independência', text: 'Não recebemos comissão de fabricantes, locadoras ou fornecedores de frota. A recomendação segue a evidência, não uma relação comercial pré-existente.' },
  { title: 'Rastreabilidade', text: 'Toda conclusão relevante está associada a um dado, documento, entrevista ou observação verificável — auditável a qualquer momento.' },
  { title: 'Triangulação', text: 'Conclusões críticas são confirmadas por mais de uma fonte sempre que possível, reduzindo o risco de decisão baseada em percepção isolada.' },
  { title: 'Decisão, não inventário', text: 'O objetivo nunca é produzir um relatório extenso. É converter informação dispersa em prioridades e decisões executivas.' },
];
---

<BaseLayout title={pageTitle} description={pageDescription} bodyClass="lm-about">
  <section class="lm-page-hero">
    <div class="container">
      <span class="eyebrow">Sobre a Mobiliza</span>
      <h1>Consultoria independente para decisões de mobilidade corporativa</h1>
      <p>
        A LuHao Mobiliza é a vertical de <strong>Fleet &amp; Mobility</strong> do grupo LuHao, dedicada a ajudar empresas a decidir — com dados, e não com achismo — como estruturar propriedade, financiamento, leasing, terceirização, assinatura ou modelos híbridos de frota.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container lm-about__intro">
      <div class="lm-section-head">
        <span class="eyebrow">Posicionamento</span>
        <h2>Uma jornada, não um projeto isolado</h2>
      </div>
      <p>
        A mobilidade corporativa raramente falha por falta de fornecedores dispostos a vender. Ela falha por falta de um diagnóstico independente, de uma comparação justa entre cenários e de governança depois que o contrato é assinado. A Mobiliza existe para preencher exatamente essa lacuna: conduzimos a jornada completa — diagnóstico, decisão, contratação, transformação e governança — com a metodologia <strong>MOVE®</strong>, ou entramos em qualquer etapa isolada quando a empresa já avançou sozinha até ali.
      </p>
      <p>
        Cada etapa gera um produto próprio e um entregável formal — do <em>Mobility Readiness Assessment®</em> ao <em>Mobility Office®</em> — para que a decisão de hoje fique registrada, seja auditável e sirva de base objetiva para o próximo ciclo.
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="lm-section-head">
        <span class="eyebrow">Princípios operacionais</span>
        <h2>O que não muda, independentemente do cliente</h2>
      </div>

      <div class="lm-values">
        {values.map((v) => (
          <div class="lm-values__card">
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container lm-audience">
      <div class="lm-audience__col">
        <div class="lm-section-head">
          <span class="eyebrow">Para quem é</span>
          <h2>Empresas que precisam decidir mobilidade com rigor</h2>
        </div>
        <ul>
          {audiences.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="lm-audience__col lm-audience__col--not">
        <div class="lm-section-head">
          <span class="eyebrow">Fora do escopo padrão</span>
          <h2>O que a Mobiliza não substitui</h2>
        </div>
        <ul>
          {notFor.map((item) => <li>{item}</li>)}
        </ul>
        <p class="lm-audience__note">Esses temas podem ser conduzidos em conjunto com especialistas convidados quando fazem parte do escopo contratado.</p>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container lm-group">
      <div class="lm-section-head lm-section-head--light">
        <span class="eyebrow">Grupo LuHao</span>
        <h2>Parte de um grupo com histórico em estruturar operações digitais e comerciais</h2>
        <p>
          A LuHao Mobiliza compartilha com o grupo LuHao a mesma disciplina de estrutura, evidência e execução aplicada a outras frentes de negócio — adaptada aqui para a complexidade específica da mobilidade corporativa: contratos, ativos, fornecedores e capital empregado.
        </p>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .lm-page-hero {
    padding: 88px 0 64px;
    background:
      linear-gradient(100deg, rgba(6, 20, 45, 0.95) 0%, rgba(6, 20, 45, 0.92) 35%, rgba(6, 20, 45, 0.6) 70%, rgba(6, 20, 45, 0.35) 100%),
      url('/images/hero-fleet.jpg');
    background-size: cover;
    background-position: center;
    color: #fff;
  }

  .lm-page-hero h1 {
    color: #fff;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.15;
    margin: 16px 0 20px;
    max-width: 800px;
  }

  .lm-page-hero p {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 17px;
  }

  .lm-section-head {
    max-width: 700px;
    margin: 0 0 28px;
  }

  .lm-section-head h2 {
    font-size: clamp(24px, 3.2vw, 34px);
    margin: 12px 0;
  }

  .lm-section-head--light h2 {
    color: #fff;
  }

  .lm-section-head--light p {
    color: rgba(255, 255, 255, 0.78);
  }

  .lm-about__intro p {
    max-width: 760px;
    font-size: 16.5px;
    color: var(--lm-ink);
    margin-bottom: 20px;
  }

  .lm-values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .lm-values__card {
    padding: 26px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(6, 26, 61, 0.08);
  }

  .lm-values__card h3 {
    font-size: 18px;
    margin-bottom: 10px;
  }

  .lm-values__card p {
    color: var(--lm-muted);
    font-size: 14.5px;
    margin: 0;
  }

  .lm-audience {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
  }

  .lm-audience ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .lm-audience li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.55;
  }

  .lm-audience li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--lm-pink);
  }

  .lm-audience__col--not li::before {
    background: var(--lm-muted);
  }

  .lm-audience__note {
    margin-top: 18px;
    font-size: 13.5px;
    color: var(--lm-muted);
  }

  .lm-group {
    max-width: 820px;
  }

  @media (max-width: 1024px) {
    .lm-values {
      grid-template-columns: repeat(2, 1fr);
    }

    .lm-audience {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .lm-values {
      grid-template-columns: 1fr;
    }
  }
</style>
